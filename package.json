{
  "name": "aura-preflight",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local-first pre-share privacy verifier for text and images.",
  "license": "Apache-2.0",
  "packageManager": "npm@9.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nahin333/Aura.git"
  },
  "bugs": {
    "url": "https://github.com/nahin333/Aura/issues"
  },
  "homepage": "https://nahin333.github.io/Aura/",
  "keywords": [
    "privacy",
    "redaction",
    "metadata",
    "ocr",
    "local-first",
    "pwa",
    "screenshot-redaction",
    "secret-scanner",
    "exif-removal",
    "data-loss-prevention",
    "privacy-tool"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/generate-pwa-icons.mjs dist/icons && node scripts/build-pwa.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "exifreader": "4.44.0",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "selenium-webdriver": "4.27.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-static-copy": "2.3.2",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=18"
  }
}
